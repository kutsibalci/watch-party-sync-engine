{
  "name": "birlikte-izleme-platformu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build:client": "esbuild src/shared/protocol-core.ts --bundle --format=esm --outfile=public/protocol.js --log-level=warning",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:realtime": "tsx watch src/realtime/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev": "npm run build:client && npm-run-all --parallel dev:api dev:realtime dev:worker",
    "migrate": "tsx scripts/migrate.ts up",
    "migrate:status": "tsx scripts/migrate.ts status",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser-test.json",
    "smoke": "tsx scripts/smoke.ts",
    "sync-test": "tsx scripts/sync-test.ts",
    "browser-test": "tsx scripts/browser-test.ts",
    "pipeline-test": "tsx scripts/pipeline-test.ts",
    "scale-test": "tsx scripts/scale-test.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "ws": "^8.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^13.0.0",
    "puppeteer-core": "^25.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
