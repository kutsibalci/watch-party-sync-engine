# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# JWT_SECRET'i mutlaka değiştirin:    node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
LOG_LEVEL=debug

# --- Servis portları ---
# 8080/8081 sıkça çakışır (WSL, Docker, Jenkins, Redmine...). 8090/8091 kullanıyoruz.
API_PORT=8090
REALTIME_PORT=8091

# --- PostgreSQL ---
DATABASE_URL=postgres://watch:watch@localhost:5432/watchparty

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3 uyumlu) ---
# S3_ENDPOINT      : sunucudan sunucuya erişim (Docker içinde http://minio:9000)
# S3_PUBLIC_ENDPOINT: TARAYICIDAN erişim. Presigned URL imzası host'u kapsadığı
#                     için imzalama bu adresle yapılmalıdır.
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Auth ---
JWT_SECRET=degistir-bunu-en-az-32-karakter-olmali-xxxxxxxx
JWT_ISSUER=birlikte-izleme
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
