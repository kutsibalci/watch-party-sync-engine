# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# JWT_SECRET'i mutlaka değiştirin:    node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
LOG_LEVEL=debug

# --- Servis portları ---
# 8080/8081 sıkça çakışır (WSL, Docker, Jenkins, Redmine...). 8090/8091 kullanıyoruz.
API_PORT=8090
REALTIME_PORT=8091
BROWSER_PORT=8094

# --- Ortak tarayıcı (yalnızca browser servisi okur) ---
# CHROME_PATH boşsa bilinen kurulum yolları taranır. Konteynerde Alpine'ın
# chromium paketi kullanılır; host'ta çalıştırıyorsanız kurulu Chrome bulunur.
# CHROME_PATH=
# Son izleyici ayrıldıktan sonra sekmenin açık kalacağı süre.
BROWSER_IDLE_MS=120000
# Aynı anda kaç odada sunucu tarayıcısı açılabilir. Her biri bir Chromium sekmesi.
BROWSER_MAX_SESSIONS=4
# Sayfanın render boyutu VE tele giden kare boyutu — ikisi aynı olmalı, yoksa
# görüntü iki kez ölçeklenip bulanıklaşır.
BROWSER_WIDTH=1280
BROWSER_HEIGHT=720
# JPEG kalitesi (20-95). Düşük değerler metni okunmaz hâle getirir.
BROWSER_QUALITY=72
# Saniyedeki en fazla kare. Kare onayını (ack) geciktirerek uygulanır; bu
# sayede hem ağ trafiği hem sunucudaki JPEG kodlama maliyeti birlikte düşer.
BROWSER_MAX_FPS=30
# Bir izleyicinin soketinde bu kadar bayt birikmişse ona kare gönderilmez.
# Yavaş bağlantıya kare yığmak görüntüyü hızlandırmaz, geciktirir.
BROWSER_MAX_BUFFERED_BYTES=786432

# --- PostgreSQL ---
DATABASE_URL=postgres://watch:watch@localhost:5432/watchparty

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3 uyumlu) ---
# S3_ENDPOINT      : sunucudan sunucuya erişim (Docker içinde http://minio:9000)
# S3_PUBLIC_ENDPOINT: TARAYICIDAN erişim. Presigned URL imzası host'u kapsadığı
#                     için imzalama bu adresle yapılmalıdır.
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Auth ---
JWT_SECRET=degistir-bunu-en-az-32-karakter-olmali-xxxxxxxx
JWT_ISSUER=birlikte-izleme
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
