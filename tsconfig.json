{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    /* tsc sadece tip kontrolü yapar; kodu tsx/node doğrudan çalıştırır. */
    "noEmit": true,
    "allowImportingTsExtensions": true,

    /* Node'un yerel tip-soyma (type stripping) özelliğiyle uyumlu kalmayı zorunlu kılar:
       enum, namespace, parameter property gibi "silinemez" sözdizimini engeller. */
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  // browser-test.ts'in evaluate() callback'leri TARAYICI bağlamında çalışır ve
  // DOM tiplerine ihtiyaç duyar. DOM lib'ini buraya eklemek yerine o dosyayı
  // ayrı bir yapılandırmaya alıyoruz (tsconfig.browser-test.json) — böylece
  // sunucu kodu yanlışlıkla `document`/`localStorage` kullanamaz.
  "exclude": ["node_modules", "dist", "scripts/browser-test.ts"]
}
